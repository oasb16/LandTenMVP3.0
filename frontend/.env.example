# Backend API URL

# NextAuth Configuration
NEXTAUTH_URL=https://thysanurous-cecilia-nonstretchable.ngrok-free.dev
NEXTAUTH_URL_INTERNAL=http://localhost:3000
NEXTAUTH_SECRET=super-secret-dev-key
NEXTAUTH_TRUST_HOST=true
NEXTAUTH_CSRF_CHECK_ORIGIN=false
BACKEND_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=https://demiurgic-stevie-polymorphous.ngrok-free.dev


# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe (for payment processing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stream Chat (for AI Support Experience and Classic Dashboard)
# IMPORTANT: Stream Chat authentication uses BACKEND environment variables only.
# Tokens are generated server-side and fetched via /api/chat/token endpoint.
# Configure these in backend/.env instead:
#   STREAM_CHAT_API_KEY=your_stream_api_key
#   STREAM_CHAT_API_SECRET=your_stream_api_secret
#   STREAM_DEFAULT_CHANNEL=landten-default
#   STREAM_AGENT_USER_ID=landten-agent
# No frontend environment variables are required for Stream Chat.
